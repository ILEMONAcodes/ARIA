{
  "name": "voice_echo",
  "description": "Phase B backend handoff: offline push-to-talk produces a caption and spoken echo, never a computer action.",
  "steps": [
    {
      "send": {
        "v": 1,
        "type": "status",
        "state": "idle",
        "online": false,
        "profile": "hosted"
      }
    },
    {
      "wait_for": "ptt.start",
      "match": {
        "v": 1,
        "type": "ptt.start"
      }
    },
    {
      "send": {
        "v": 1,
        "type": "status",
        "state": "listening",
        "online": false,
        "profile": "hosted"
      }
    },
    {
      "wait_for": "ptt.stop",
      "match": {
        "v": 1,
        "type": "ptt.stop"
      }
    },
    {
      "send": {
        "v": 1,
        "type": "status",
        "state": "thinking",
        "online": false,
        "profile": "hosted"
      }
    },
    {
      "send": {
        "v": 1,
        "type": "transcript.partial",
        "text": "Open the policy folder."
      }
    },
    {
      "send": {
        "v": 1,
        "type": "transcript.final",
        "text": "Open the policy folder."
      }
    },
    {
      "send": {
        "v": 1,
        "type": "status",
        "state": "working",
        "online": false,
        "profile": "hosted"
      }
    },
    {
      "send": {
        "v": 1,
        "type": "reply.text",
        "task_id": "voice-fixture",
        "text": "Open the policy folder.",
        "spoken": true
      }
    },
    {
      "send": {
        "v": 1,
        "type": "status",
        "state": "listening",
        "online": false,
        "profile": "hosted"
      }
    },
    {
      "send": {
        "v": 1,
        "type": "activity.entry",
        "id": "voice-activity-fixture",
        "ts": "2026-01-01T00:00:00Z",
        "text": "Voice echo completed.",
        "undoable": false
      }
    },
    {
      "send": {
        "v": 1,
        "type": "status",
        "state": "idle",
        "online": false,
        "profile": "hosted"
      }
    }
  ]
}

{
  "name": "email_outbox_queue",
  "description": "MAIL-2, SYSX-2: queue send offline, reconnect and send exactly once with idempotency",
  "steps": [
    {
      "send": {
        "v": 1,
        "type": "status",
        "state": "idle",
        "online": false,
        "profile": "hosted"
      }
    },
    {
      "wait_for": "text.input",
      "match": {
        "v": 1,
        "type": "text.input",
        "text": "send the reply to Mr Bello"
      }
    },
    {
      "send": {
        "v": 1,
        "type": "transcript.final",
        "text": "send the reply to Mr Bello"
      }
    },
    {
      "send": {
        "v": 1,
        "type": "plan.preview",
        "task_id": "send-task",
        "summary": "Run 1 registered step(s)."
      }
    },
    {
      "send": {
        "v": 1,
        "type": "status",
        "state": "working",
        "online": false,
        "profile": "hosted"
      }
    },
    {
      "send": {
        "v": 1,
        "type": "result.answer",
        "text": "Network is offline. Reply queued in outbox. Will send when connection returns.",
        "citations": []
      }
    },
    {
      "send": {
        "v": 1,
        "type": "outbox.update",
        "items": [
          {
            "id": "outbox-1",
            "status": "queued",
            "to": ["bello@company.ng"],
            "subject": "Re: Monday meeting",
            "attempts": 0
          }
        ]
      }
    },
    {
      "send": {
        "v": 1,
        "type": "activity.entry",
        "id": "outbox-activity",
        "ts": "2026-01-01T00:00:00Z",
        "text": "Queued email to Mr Bello for sending when online.",
        "undoable": false
      }
    },
    {
      "send": {
        "v": 1,
        "type": "reply.text",
        "task_id": "send-task",
        "text": "Network is offline. Reply queued in outbox. Will send when connection returns.",
        "spoken": true
      }
    },
    {
      "send": {
        "v": 1,
        "type": "status",
        "state": "idle",
        "online": false,
        "profile": "hosted"
      }
    }
  ]
}
{
  "name": "open_policy_source",
  "description": "D2: an offline policy citation opens only its validated, unchanged source in a configured viewer.",
  "steps": [
    {
      "send": {
        "v": 1,
        "type": "status",
        "state": "idle",
        "online": false,
        "profile": "hosted"
      }
    },
    {
      "wait_for": "text.input",
      "match": {
        "v": 1,
        "type": "text.input",
        "text": "search policy annual leave"
      }
    },
    {
      "send": {
        "v": 1,
        "type": "transcript.final",
        "text": "search policy annual leave"
      }
    },
    {
      "send": {
        "v": 1,
        "type": "plan.preview",
        "task_id": "policy-task",
        "summary": "Run 1 registered step(s)."
      }
    },
    {
      "send": {
        "v": 1,
        "type": "status",
        "state": "working",
        "online": false,
        "profile": "hosted"
      }
    },
    {
      "send": {
        "v": 1,
        "type": "result.answer",
        "text": "Offline keyword matches; these passages are not a generated answer.",
        "citations": [
          {
            "doc": "Fictional Leave Policy",
            "page": null,
            "date": "2026-01-15",
            "passage": "Section: Eligibility\n\nAnnual leave requires a completed request form.",
            "file_path": "C:/fictional/policies/leave.txt"
          }
        ]
      }
    },
    {
      "send": {
        "v": 1,
        "type": "activity.entry",
        "id": "policy-activity",
        "ts": "2026-01-01T00:00:00Z",
        "text": "Completed kb.search.",
        "undoable": false
      }
    },
    {
      "send": {
        "v": 1,
        "type": "reply.text",
        "task_id": "policy-task",
        "text": "Offline keyword matches; these passages are not a generated answer.",
        "spoken": false
      }
    },
    {
      "send": {
        "v": 1,
        "type": "status",
        "state": "idle",
        "online": false,
        "profile": "hosted"
      }
    },
    {
      "wait_for": "source.open",
      "match": {
        "v": 1,
        "type": "source.open",
        "file_path": "C:/fictional/policies/leave.txt",
        "page": null
      }
    },
    {
      "send": {
        "v": 1,
        "type": "plan.preview",
        "task_id": "open-source-task",
        "summary": "Run 1 registered step(s)."
      }
    },
    {
      "send": {
        "v": 1,
        "type": "status",
        "state": "working",
        "online": false,
        "profile": "hosted"
      }
    },
    {
      "send": {
        "v": 1,
        "type": "activity.entry",
        "id": "open-source-activity",
        "ts": "2026-01-01T00:00:00Z",
        "text": "Completed files.open.",
        "undoable": false
      }
    },
    {
      "send": {
        "v": 1,
        "type": "reply.text",
        "task_id": "open-source-task",
        "text": "Started the source viewer. Use the cited section to locate the passage.",
        "spoken": false
      }
    },
    {
      "send": {
        "v": 1,
        "type": "status",
        "state": "idle",
        "online": false,
        "profile": "hosted"
      }
    }
  ]
}
